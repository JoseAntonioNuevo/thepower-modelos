# Plantilla de configuración: copia este archivo a .env en tu entorno local.
# Las opciones locales no necesitan claves. Nunca rellenes esta plantilla pública
# con credenciales: .env permanece fuera de Git.

# Autenticación de llamadas remotas por OpenRouter. Vacío: esa ruta se detiene.
OPENROUTER_API_KEY=
# Modelo original de Transformers que utilizan entrenamiento e inferencia Qwen.
OPEN_MODEL_ID=Qwen/Qwen3-0.6B
# Commit exacto del Hub: fija pesos y tokenizer para las tres condiciones.
# El manifiesto congelado también lo registra y rechaza un cambio incompatible.
OPEN_MODEL_REVISION=c1899de289a04d12100db370d81485cdf75e47ca
# API compatible de LM Studio; /models descubre IDs y /chat/completions consulta.
# El comparador propio original/LoRA utiliza otro servidor: localhost:1235/v1.
LOCAL_BASE_URL=http://localhost:1234/v1
# Opcional: descomenta y usa el ID real de tu servidor LM Studio.
# LOCAL_MODEL_ID=ID_REAL
# Modelos OpenRouter/Google se indican con --modelo en los comandos.
# Proyecto explícito del laboratorio. Vacío: no se crea cliente ni se usa otro
# proyecto por defecto de las credenciales ADC.
GOOGLE_CLOUD_PROJECT=
# Ubicación de inferencia Google. Es distinta de europe-west4, región del tuning.
GEMINI_SERVING_LOCATION=eu
# Bucket existente del laboratorio para los JSONL de train y validación.
# Convertir el test localmente no significa subirlo al entrenamiento.
TUNING_BUCKET=
# Tuning fija europe-west4; presupuesto/estimación se pasan por CLI, no por .env.
# El destino de publicación HF se indica con --repo.
# HF_TOKEN y credenciales Google se configuran fuera del repositorio.
